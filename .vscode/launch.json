{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach to Hermes application",
            "cwd": "${workspaceFolder}",
            "type": "reactnativedirect",
            "request": "attach"
        },
        {
            "name": "Debug Android",
            "type": "reactnative",
            "request": "launch",
            "platform": "android",
            "sourceMaps": true,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Debug iOS",
            "type": "reactnative",
            "request": "launch",
            "platform": "ios",
            "sourceMaps": true,
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Attach to Packager",
            "type": "reactnative",
            "request": "attach",
            "port": 8081,
            "sourceMaps": true,
            "cwd": "${workspaceFolder}"
        }
    ]
}